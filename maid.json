{
  "main_branch": "main",
  "test": {
    "adapter": "go",
    "command": ["go", "test", "-json", "./..."]
  },
  "format_check": ["gofmt", "-l", "."],
  "lint": ["go", "vet", "./..."],
  "budget": {
    "attempts": 2,
    "max_changed_lines": 300
  },
  "port_range": 100,
  "code_review_graph": {
    "command": [".maid/crg-venv/bin/code-review-graph"],
    "args": ["serve"],
    "enabled": true
  }
}
